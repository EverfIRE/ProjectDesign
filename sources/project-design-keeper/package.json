{
  "name": "project-design-keeper",
  "version": "1.0.2",
  "description": "Distill local project evidence into validated design documentation and reusable project context.",
  "private": true,
  "type": "module",
  "author": {
    "name": "EverfIRE",
    "url": "https://github.com/EverfIRE"
  },
  "homepage": "https://github.com/EverfIRE/ProjectDesign#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/EverfIRE/ProjectDesign.git",
    "directory": "sources/project-design-keeper"
  },
  "bugs": {
    "url": "https://github.com/EverfIRE/ProjectDesign/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --maxWorkers=1 --testTimeout=120000",
    "test:task10-local": "npm run test:ci && vitest run --config vitest.task10-local.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --maxWorkers=1 --testTimeout=120000",
    "test:perf": "npm run build && node test/performance.mjs --scenario full",
    "benchmark:prepare": "node scripts/create-benchmark-fixture.mjs",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js",
    "smoke": "npm run build && node test/smoke.mjs",
    "smoke:installed": "node scripts/smoke-installed-plugin.mjs",
    "package": "npm run build && node scripts/package-plugin.mjs",
    "package:verify": "npm run package && node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.25.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "nanoid": "^3.3.18"
  }
}
